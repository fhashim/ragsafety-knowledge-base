# ============================================================================
# ragsafety local configuration. Copy to `.env` and edit.
#   cp .env.example .env
# NEVER put real secrets in code, tfvars, or Terraform outputs. For real Azure,
# prefer `az login` + managed identity; this file holds only non-secret config.
# ============================================================================

# --- Mode -------------------------------------------------------------------
# true  = deterministic fake embeddings, stub LLM, in-memory index, local audit.
#         No Azure credentials required. All tests/demos/ablations run.
# false = call real Azure services (requires the endpoints below + az login).
RAGSAFETY_MOCK_MODE=true

# Logging: DEBUG | INFO | WARNING | ERROR
RAGSAFETY_LOG_LEVEL=INFO

# --- Chunking / retrieval ---------------------------------------------------
# fixed_no_overlap | fixed_overlap | section_aware
RAGSAFETY_CHUNK_STRATEGY=section_aware
RAGSAFETY_CHUNK_SIZE_TOKENS=320
RAGSAFETY_CHUNK_OVERLAP_TOKENS=64
# vector | bm25 | hybrid | hybrid_rerank
RAGSAFETY_RETRIEVAL_MODE=hybrid_rerank
RAGSAFETY_TOP_K=5

# --- Feature flags ----------------------------------------------------------
RAGSAFETY_ENABLE_BING_GROUNDING=false

# --- MCP client (the `make webui` browser explorer connects to this) --------
# URL of a RUNNING MCP server, including the /mcp path.
#   local  : http://127.0.0.1:8000/mcp   (start with `make mcp`)
#   Azure  : https://<app>.<region>.azurecontainerapps.io/mcp
RAGSAFETY_MCP_URL=http://127.0.0.1:8000/mcp
# Auth for the MCP endpoint (optional). A static bearer token wins; otherwise an
# Entra scope is exchanged for a token via DefaultAzureCredential (az login /
# managed identity). Extra headers (e.g. a Functions key) go in the JSON object.
RAGSAFETY_MCP_BEARER_TOKEN=
RAGSAFETY_MCP_AAD_SCOPE=
RAGSAFETY_MCP_HEADERS_JSON=

# --- Active persona (demo / CLI default) ------------------------------------
# priya (grp-electrical) | marcus (grp-gas)
RAGSAFETY_PERSONA=priya

# ============================================================================
# The settings below are IGNORED when RAGSAFETY_MOCK_MODE=true.
# They are populated by the Terraform platform outputs (see README).
# ============================================================================

# --- Foundry ---------------------------------------------------------------
RAGSAFETY_FOUNDRY_ENDPOINT=
RAGSAFETY_FOUNDRY_PROJECT_ENDPOINT=
RAGSAFETY_CHAT_SMALL_DEPLOYMENT=gpt-4.1-mini
RAGSAFETY_CHAT_LARGE_DEPLOYMENT=gpt-4.1
RAGSAFETY_EMBEDDING_DEPLOYMENT=text-embedding-3-large
RAGSAFETY_EMBEDDING_DIM=256

# --- Azure AI Search --------------------------------------------------------
RAGSAFETY_SEARCH_ENDPOINT=
RAGSAFETY_SEARCH_INDEX_PREFIX=ragsafety

# --- Document Intelligence --------------------------------------------------
RAGSAFETY_DOCINTEL_ENDPOINT=

# --- Content Safety ---------------------------------------------------------
RAGSAFETY_CONTENT_SAFETY_ENDPOINT=

# --- Storage (audit) --------------------------------------------------------
RAGSAFETY_STORAGE_ACCOUNT=
RAGSAFETY_AUDIT_TABLE=ragaudit
RAGSAFETY_AUDIT_BLOB_CONTAINER=audit-raw

# --- Observability ----------------------------------------------------------
# Leave blank in mock mode; set to App Insights connection string for Azure.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Runtime identity (managed identity client id, non-secret) --------------
RAGSAFETY_MANAGED_IDENTITY_CLIENT_ID=
